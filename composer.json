{
    "name": "zerofront/module-zero-promotions",
    "description": "Zero for Magento Open Source: more cart price rule actions: \"every Nth item, the cheapest, X% off\" and a free gift.",
    "type": "magento2-module",
    "version": "1.3.6",
    "license": [
        "OSL-3.0",
        "AFL-3.0"
    ],
    "authors": [
        {
            "name": "Roman Pasichnyk"
        }
    ],
    "homepage": "https://zerofront.dev",
    "keywords": [
        "magento",
        "magento2",
        "magento-open-source",
        "zero",
        "promotions",
        "cart-price-rules",
        "free-gift"
    ],
    "require": {
        "php": "~8.2.0||~8.3.0||~8.4.0",
        "magento/framework": "103.0.*",
        "magento/module-catalog": "*",
        "magento/module-checkout": "*",
        "magento/module-quote": "*",
        "magento/module-sales-rule": "*",
        "magento/module-ui": "*"
    },
    "replace": {
